#!/usr/bin/env python3
"""Assert scripts/upstream-magpie.sh embeds the pin Linux keyless commands."""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / "scripts" / "upstream-magpie.sh"
PIN = "e297a8ab27461ed32b03ce8be0f9bf957a2e754d"

REQUIRED_SNIPPETS = (
    "export MAGPIE_NO_ACCOUNTS=1",
    "sudo apt-get update",
    "sudo apt-get install -y libgtk-3-dev libwebkit2gtk-4.1-dev",
    "bad=$(gofmt -l $(git ls-files '*.go'))",
    'if [ -n "$bad" ]; then echo "not gofmt\'d:"; echo "$bad"; exit 1; fi',
    "go vet -tags gtk3 ./...",
    "go test -tags gtk3 ./...",
    PIN,
)


def main() -> int:
    if not SCRIPT.is_file():
        print(f"missing {SCRIPT}", file=sys.stderr)
        return 1
    text = SCRIPT.read_text(encoding="utf-8")
    missing = [s for s in REQUIRED_SNIPPETS if s not in text]
    if missing:
        print("upstream-parity missing snippets:", file=sys.stderr)
        for item in missing:
            print(f"  - {item!r}", file=sys.stderr)
        return 1
    print("upstream-parity OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
